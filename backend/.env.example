NODE_ENV=development
PORT=3021
FRONTEND_URL=http://localhost:3020

# App database (users, issues, history, system registry)
DATABASE_URL="sqlserver://localhost:1433;database=DataAxisHulp;integratedSecurity=true;encrypt=false;trustServerCertificate=true"

JWT_SECRET=dataaxis-hulp-jwt-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dataaxis-hulp-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@dataaxis.local
ADMIN_PASSWORD=Admin!2026
ADMIN_FULL_NAME=System Administrator

# Local / non-production connections
SYSTEM_DB_KADASTER_STATIA_URL="sqlserver://localhost:1433;database=KadasterStatia-BDMigration;integratedSecurity=true;encrypt=false;trustServerCertificate=true"
SYSTEM_DB_KADASTER_SABA_URL="sqlserver://localhost:1433;database=KadasterSabaBDMigration;integratedSecurity=true;encrypt=false;trustServerCertificate=true"
SYSTEM_DB_KADASTER_BONAIRE_URL="sqlserver://localhost:1433;database=Kadaster-BDMigration;integratedSecurity=true;encrypt=false;trustServerCertificate=true"

# Production connections (keys/env vars with _PROD show a permanent warning in Support Center)
SYSTEM_DB_KADASTER_STATIA_PROD_URL="sqlserver://host:1433;database=KadasterStatia-BDMigration;user=user;password=password;trustServerCertificate=true;encrypt=true"
SYSTEM_DB_KADASTER_SABA_PROD_URL="sqlserver://host:1433;database=KadasterSaba-BDMigration;user=user;password=password;trustServerCertificate=true;encrypt=true"
SYSTEM_DB_KADASTER_BONAIRE_PROD_URL="sqlserver://host:1433;database=Kadaster-BDMigration;user=user;password=password;trustServerCertificate=true;encrypt=true"
