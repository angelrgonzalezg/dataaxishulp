NODE_ENV=development
PORT=3021
FRONTEND_URL=http://localhost:3020

# App database (users, issues, history, system registry)
DATABASE_URL="sqlserver://localhost:1433;database=DataAxisHulp;integratedSecurity=true;encrypt=false;trustServerCertificate=true"

JWT_SECRET=dataaxis-hulp-jwt-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dataaxis-hulp-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@dataaxis.local
ADMIN_PASSWORD=Admin!2026
ADMIN_FULL_NAME=System Administrator

# Local / non-production connections
SYSTEM_DB_KADASTER_STATIA_URL="sqlserver://localhost:1433;database=KadasterStatia-BDMigration;integratedSecurity=true;encrypt=false;trustServerCertificate=true"
SYSTEM_DB_KADASTER_SABA_URL="sqlserver://localhost:1433;database=KadasterSabaBDMigration;integratedSecurity=true;encrypt=false;trustServerCertificate=true"
SYSTEM_DB_KADASTER_BONAIRE_URL="sqlserver://localhost:1433;database=Kadaster-BDMigration;integratedSecurity=true;encrypt=false;trustServerCertificate=true"
SYSTEM_DB_DLV_ARUBA_URL="sqlserver://localhost:1433;database=tereno_dev_AG_local;integratedSecurity=true;encrypt=false;trustServerCertificate=true"

# Production connections (keys/env vars with _PROD show a permanent warning in Support Center)
SYSTEM_DB_KADASTER_STATIA_PROD_URL="sqlserver://host:1433;database=KadasterStatia-BDMigration;user=user;password=password;trustServerCertificate=true;encrypt=true"
SYSTEM_DB_KADASTER_SABA_PROD_URL="sqlserver://host:1433;database=KadasterSaba-BDMigration;user=user;password=password;trustServerCertificate=true;encrypt=true"
SYSTEM_DB_KADASTER_BONAIRE_PROD_URL="sqlserver://host:1433;database=Kadaster-BDMigration;user=user;password=password;trustServerCertificate=true;encrypt=true"
# Kadaster ATL (PROD) — SQL Server SRV-DEV16
SYSTEM_DB_KADASTER_ATL_PROD_URL="sqlserver://200.6.147.70:1433;database=KadasterMigrationATL;user=kador1;password=password;encrypt=true;trustServerCertificate=true"
# DLV Aruba (PROD) — Azure SQL; VPN required. Host name says "dev" but treated as production in the app.
SYSTEM_DB_DLV_ARUBA_PROD_URL="sqlserver://sql-tereno-dev.database.windows.net:1433;database=sqldb-tereno-dev;user=angel;password=password;encrypt=true;trustServerCertificate=true"

# Monday.com — Issues inbox (token never committed; get from Monday → Developers → My Access Tokens)
MONDAY_API_TOKEN=
MONDAY_WORKSPACE_NAME=Projects 2026
MONDAY_STATUS_COLUMN=Status
MONDAY_DONE_STATUS=Done
# Optional: override boards JSON (array of { key, label, boardName, groupName, defaultSystemKey })
# MONDAY_BOARDS=[{"key":"statia","label":"Statia Issues 2026","boardName":"Statia Issues 2026","groupName":"Open Issues","defaultSystemKey":"kadaster_statia"},{"key":"saba","label":"Saba Issues 2026","boardName":"Saba Issues 2026","groupName":"Open Issues","defaultSystemKey":"kadaster_saba"},{"key":"bonaire","label":"Bonaire Issues","boardName":"Bonaire Issues","groupName":"Tickets","defaultSystemKey":"kadaster_bonaire"},{"key":"dlv","label":"DLV Issues","boardName":"DLV Issues","groupName":"Issues","defaultSystemKey":"kadaster_statia"}]
# Legacy single-board overrides (optional; defaults are built-in for all four boards):
# MONDAY_BOARD_NAME=Statia Issues 2026
# MONDAY_GROUP_NAME=Open Issues
# MONDAY_DEFAULT_SYSTEM_KEY=kadaster_statia
# Optional IDs if name lookup fails:
# MONDAY_WORKSPACE_ID=
