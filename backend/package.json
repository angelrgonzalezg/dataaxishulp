{
  "name": "dataaxis-hulp-backend",
  "version": "1.0.0",
  "description": "DataAxis Hulp — Issue management API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc && node -e \"require('fs').mkdirSync('dist/utils',{recursive:true}); require('fs').copyFileSync('src/utils/tediousWorker.cjs','dist/utils/tediousWorker.cjs')\"",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "seed:systems": "tsx src/scripts/seedSystems.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "msnodesqlv8": "^5.2.1",
    "mssql": "^11.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.10.2",
    "prisma": "^6.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
